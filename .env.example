# Copy to .env and fill in your own keys. Do NOT commit .env.

LC_GATEWAY_KEY=

# Tavily web search
TAVILY_API_KEY=

# LangSmith: tracing + Prompt Hub (system prompt) + Context Hub (skills & memory).
# Use a key SCOPED TO THE WORKSPACE where these repos live — then it resolves its
# own tenant and you do NOT need LANGSMITH_WORKSPACE_ID. (An org/multi-workspace
# key resolves no tenant by default and 404s; set LANGSMITH_WORKSPACE_ID for those.)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=ambient-analyst

# LangSmith resource identifiers (optional overrides for staging vs production).
# AMBIENT_ANALYST_PROMPT_NAME=ambient-analyst-prompt
# AMBIENT_ANALYST_MEMORY_REPO=ambient-analyst-memory
# AMBIENT_ANALYST_SKILLS=ambient-analyst-model-evaluation,ambient-analyst-benchmark-analysis,ambient-analyst-landscape-mapping,ambient-analyst-scorecard-maintenance,ambient-analyst-continuous-learning
# AMBIENT_ANALYST_SANDBOX=ambient-analyst-sandbox

# Cap on the /memory/ corpus injected into the system prompt on every model turn.
# AMBIENT_ANALYST_MEMORY_CHAR_BUDGET=40000
# AMBIENT_ANALYST_MEMORY_STRICT=1  # fail startup when the corpus exceeds the budget
