# ---- Server-side (used by the /api/lg proxy; never sent to the browser) ----
# Where the proxy forwards. Local dev server, or a LangSmith deployment URL.
LANGGRAPH_DEPLOYMENT_URL=http://127.0.0.1:2024
# Required only when LANGGRAPH_DEPLOYMENT_URL is a LangSmith deployment.
LANGSMITH_API_KEY=

# ---- Client-side (optional) ----
# Assistant / graph id from langgraph.json.
NEXT_PUBLIC_LANGGRAPH_ASSISTANT_ID=llm_research_agent
# Uncomment to bypass the proxy and connect the browser straight to a server
# (only sensible for a local server that needs no key):
# NEXT_PUBLIC_LANGGRAPH_API_URL=http://127.0.0.1:2024
